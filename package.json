{
  "name": "lunch-together",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Коллективные заказы обедов с PostgreSQL и кабинетом поставщика",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "setup": "node scripts/setup-env.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 server/test/*.test.mjs",
    "db:dev": "docker compose -p lunch-together-dev -f compose.yml -f compose.dev.yml up -d db"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": { "@vitejs/plugin-react": "^6.1.2", "vite": "^8.3.4" }
}
